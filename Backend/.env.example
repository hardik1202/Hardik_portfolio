# Local development (when MongoDB runs locally on host):
# MONGO_URI=mongodb://localhost:27017/taskmanager

# Docker Compose environment (uses Docker internal DNS service name 'mongodb'):
MONGO_URI=mongodb://mongodb:27017/taskmanager
JWT_SECRET=your_jwt_secret_here
PORT=5000

# Practical 13: External AI API Configuration (Keep server-side only; never expose to frontend)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here